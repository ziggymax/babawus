<!--
  The Linux Mint 22.3 test VM, with Cinnamon on X11 (T-127), set up as the Ubuntu 26.04 one
  (T-126). vms/driver.py defines it in libvirt's user session, with @IMAGES@ replaced by the
  folder the disks are kept in (issue 170).

  BIOS rather than UEFI, because libvirt can't take an internal snapshot of a VM with UEFI
  firmware, and an internal snapshot of the running VM lets a revert return straight to a desktop
  that is logged in. Every guest has the same settings (TestSetup.md, "The VMs"):
  - the network is QEMU's own, with SSH forwarded from 127.0.0.1:<ssh port> on the host;
  - VNC listens only on the host, so that the user can watch in virt-manager;
  - a USB tablet as pointer, so that clicks land on exact coordinates;
  - a USB 3 controller, for plugging in sticks;
  - a fixed screen size, so that screenshots can be compared between runs.
-->
<domain type="kvm">
  <name>babawus-mint-22.3</name>
  <metadata>
    <babawus:guest xmlns:babawus="https://github.com/ziggymax/babawus/vms">
      <babawus:ssh port="2602" user="tester"/>
    </babawus:guest>
  </metadata>
  <memory unit="GiB">4</memory>
  <vcpu>4</vcpu>
  <os>
    <type arch="x86_64" machine="q35">hvm</type>
    <!-- The disk is empty until Ubuntu is installed, so the first start boots the installer. -->
    <boot dev="hd"/>
    <boot dev="cdrom"/>
  </os>
  <features>
    <acpi/>
    <apic/>
  </features>
  <cpu mode="host-passthrough"/>
  <clock offset="utc">
    <timer name="rtc" tickpolicy="catchup"/>
    <timer name="pit" tickpolicy="delay"/>
    <timer name="hpet" present="no"/>
  </clock>
  <devices>
    <disk type="file" device="disk">
      <driver name="qemu" type="qcow2" discard="unmap"/>
      <source file="@IMAGES@/babawus-mint-22.3.qcow2"/>
      <target dev="vda" bus="virtio"/>
    </disk>
    <disk type="file" device="cdrom">
      <driver name="qemu" type="raw"/>
      <source file="@IMAGES@/linuxmint-22.3-cinnamon-64bit.iso"/>
      <target dev="sda" bus="sata"/>
      <readonly/>
    </disk>
    <controller type="usb" model="qemu-xhci" ports="8"/>
    <controller type="pci" model="pcie-root"/>
    <controller type="pci" model="pcie-root-port"/>
    <controller type="pci" model="pcie-root-port"/>
    <controller type="pci" model="pcie-root-port"/>
    <controller type="pci" model="pcie-root-port"/>
    <controller type="pci" model="pcie-root-port"/>
    <controller type="pci" model="pcie-root-port"/>
    <controller type="pci" model="pcie-root-port"/>
    <controller type="pci" model="pcie-root-port"/>
    <!-- QEMU's own network (slirp). vms/driver.py forwards the SSH port when it starts the
         guest, because libvirt forwards ports only for passt, which doesn't work in the user
         session on Ubuntu 26.04 (TestSetup.md, "The VMs"). -->
    <interface type="user">
      <model type="virtio"/>
    </interface>
    <console type="pty"/>
    <input type="tablet" bus="usb"/>
    <graphics type="vnc" port="5962" listen="127.0.0.1"/>
    <video>
      <model type="virtio">
        <resolution x="1280" y="800"/>
      </model>
    </video>
    <memballoon model="virtio"/>
    <rng model="virtio">
      <backend model="random">/dev/urandom</backend>
    </rng>
  </devices>
</domain>
